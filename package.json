{
    "name": "@considbrs-webdev/modularity-noticeboard",
    "version": "1.0.0",
    "description": "A Modularity module that implements a municipal digital noticeboard for publishing legally binding public notices—meeting summons, agendas, adjusted minutes and decisions—replacing the physical noticeboard, managing appeal deadlines under municipal law, and providing accessible, auditable, and integratable publication workflows.",
    "main": "",
    "repository": {
        "type": "git",
        "url": "https://github.com/considbrs-webdev/modularity-noticeboard"
    },
    "author": "Consid Borås AB",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/considbrs-webdev/modularity-noticeboard/issues"
    },
    "homepage": "https://github.com/considbrs-webdev/modularity-noticeboard#readme",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:dev": "vite build --mode development",
        "watch": "vite build --watch --mode development",
        "make-pot": "wp i18n make-pot . languages/modularity-noticeboard.pot --include=\"source/php,modularity-noticeboard.php\" --domain=modularity-noticeboard"
    },
    "browserslist": [
        "> 1%",
        "not dead"
    ],
    "devDependencies": {
        "typescript": "^5.9.2",
        "vite": "^7.1.2",
        "vite-config-factory": "^1.0.1",
        "sass-embedded": "^1.93.3"
    },
    "browser": {
        "child_process": false
    }
}